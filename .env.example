# Supabase 实时同步配置(可选)
# 复制本文件为 .env.local 并填入你的 Supabase 项目凭据
# 未配置时应用自动进入本地演示模式(同一浏览器多标签同步)
#
# 1. 在 https://supabase.com 创建免费项目
# 2. 在 SQL Editor 中执行 supabase/schema.sql
# 3. 在 Project Settings -> API 中找到 URL 和 anon key
# 4. 填入下面两行,重启 npm run dev
# 5. 部署到 Vercel 时,在项目设置 -> Environment Variables 添加同样的变量

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
